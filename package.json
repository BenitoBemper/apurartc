{
  "name": "apurartc",
  "private": true,
  "version": "0.1.0",
  "description": "ApuraRTC — SaaS de validação, cálculo e apuração de IBS/CBS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev -w apps/worker",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "calc:up": "docker compose up -d --build calculadora",
    "calc:down": "docker compose down",
    "calc:logs": "docker compose logs -f calculadora",
    "calc:test": "node infra/calculadora/testar.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --schema public > packages/db/src/database.types.ts",
    "test": "npm run test -w apps/worker && npm run db:test",
    "test:e2e": "npm run test:e2e -w apps/worker"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
