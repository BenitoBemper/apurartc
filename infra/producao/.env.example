# Copie para .env.producao (no servidor) e preencha. NUNCA commite o .env.producao.
# Supabase → Project Settings → Database → Connection string → "Session pooler" (IPv4; necessário para a fila pgmq)
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha-do-banco>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_SECRET_KEY=
POLL_MS=2000
